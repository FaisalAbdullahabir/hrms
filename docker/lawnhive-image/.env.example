# LawnHive Workspace - Client Environment Variables
# Copy this file to .env and update the values

# Client ID (set during installation)
CLIENT_ID=NGO001

# MariaDB root password (REQUIRED - change this!)
DB_ROOT_PASSWORD=changeme

# MariaDB application password (change this too!)
DB_PASSWORD=changeme

# Redis password (REQUIRED - change this!)
REDIS_PASSWORD=changeme

# Frappe admin password (default: admin - change after first login!)
ADMIN_PASSWORD=admin

# Port to access the web interface (default: 8000)
FRAPPE_PORT=8000
